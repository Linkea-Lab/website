{%- comment -%}
█████████████████████████████████████████████████████████████████
██  BLOQUE · ENLACE + POPUP "¿SE VE ASÍ DE VERDAD?"
██  Todo lo editable está entre las dos rayas de abajo.
█████████████████████████████████████████████████████████████████
{%- endcomment -%}

{%- comment -%} ═══════════════════ EDITA AQUÍ ═══════════════════ {%- endcomment -%}
{%- assign ENLACE_TEXTO = '¿Se ve así de verdad?' -%}

{%- assign MEDIA = '' -%}
{%- comment -%} El vídeo del wooow: 3-4 segundos, grabado en tu casa, vertical o 4:3.
                Acepta .mp4 .webm .mov, YouTube, Vimeo o una foto. Vacío = hueco. {%- endcomment -%}
{%- assign MEDIA_RATIO = '4/3' -%}

{%- assign POPUP_TITULO = 'Sí, y esto es lo que necesitas para que se vea' -%}
{%- assign POPUP_ENTRADA = 'Vídeo grabado en nuestro salón, sin retocar, con el móvil.' -%}

{%- comment -%} Cada condición: negrita | resto · separa con ~ {%- endcomment -%}
{%- assign CONDICIONES = 'Necesita oscuridad|como cualquier proyector. Con la luz encendida no se ve; con la persiana bajada, sí.~Techo blanco y liso|es donde mejor sale. En gotelé funciona, pero algo menos definido.~Techo oscuro o con vigas|mejor apunta a una pared clara y rebota.' -%}

{%- assign POPUP_REMATE = 'Si al recibirlo ves que en tu casa no luce, tienes 14 días para devolverlo.' -%}
{%- assign BOTON_CERRAR = 'Entendido' -%}

{%- assign COLOR_ENLACE    = '#0B6FA8' -%}
{%- assign COLOR_FONDO     = '#FFFFFF' -%}
{%- assign COLOR_TITULO    = '#222222' -%}
{%- assign COLOR_TEXTO     = '#444444' -%}
{%- assign COLOR_CIRCULO   = '#38B6FF' -%}
{%- assign COLOR_REMATE_BG = '#E6F6FF' -%}
{%- assign COLOR_BOTON     = '#009BF0' -%}
{%- assign CARGAR_FUENTE = false -%}
{%- comment -%} En false porque la fuente ya se carga desde theme.liquid, autoalojada.
                Ponlo en true solo si pegas este bloque en una tienda que no la tenga. {%- endcomment -%}

{%- comment -%} ══════════ FIN · NO TOQUES NADA MÁS ABAJO ═════════ {%- endcomment -%}

{%- if CARGAR_FUENTE -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap">
{%- endif -%}


{%- if ENLACE_TEXTO != blank -%}

<style>
.k3-pv-abrir{
  display:inline-block;
  margin:14px 0 0;
  padding:0;
  border:0;
  background:none;
  font-family:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
  font-size:0.95rem;
  font-weight:700;
  color:{{ COLOR_ENLACE }};
  text-decoration:underline;
  text-underline-offset:4px;
  cursor:pointer;
}
.k3-pv-abrir:hover{ text-decoration-thickness:2px; }
.k3-pv-abrir:focus-visible{ outline:2px solid {{ COLOR_CIRCULO }}; outline-offset:3px; }

.k3-pv-fondo{
  display:none;
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:9999;
  background:rgba(12,16,38,0.72);
  -webkit-backdrop-filter:blur(3px);
  backdrop-filter:blur(3px);
  padding:16px;
  padding-top:calc(16px + env(safe-area-inset-top, 0px));
  padding-bottom:calc(16px + env(safe-area-inset-bottom, 0px));
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.k3-pv-fondo.abierto{ display:flex; align-items:center; justify-content:center; }

.k3-pv-caja{
  font-family:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
  background:{{ COLOR_FONDO }};
  color:{{ COLOR_TEXTO }};
  border-radius:14px;
  width:100%;
  max-width:560px;
  position:relative;
  box-shadow:0 18px 48px rgba(0,0,0,0.3);
  overflow:hidden;
}
.k3-pv-cerrar{
  position:absolute;
  top:10px; right:10px;
  z-index:2;
  width:34px; height:34px;
  border:0;
  border-radius:50%;
  background:rgba(255,255,255,0.92);
  color:{{ COLOR_TITULO }};
  font-size:1.3rem;
  font-weight:700;
  line-height:1;
  cursor:pointer;
  display:flex; align-items:center; justify-content:center;
}
.k3-pv-cerrar:hover{ background:#FFFFFF; }
.k3-pv-cerrar:focus-visible{ outline:2px solid {{ COLOR_CIRCULO }}; outline-offset:2px; }

.k3-pv-media, .k3-pv-marco, .k3-pv-hueco{
  width:100%;
  display:block;
  background:#0F1430;
}
.k3-pv-media{ object-fit:cover; }
.k3-pv-marco{ position:relative; }
.k3-pv-marco iframe{ position:absolute; top:0; left:0; width:100%; height:100%; border:0; }
.k3-pv-hueco{
  border:1px dashed #39427A;
  color:#7C86BC;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:6px; text-align:center; padding:18px;
  font-size:0.8rem; font-weight:700;
}
.k3-pv-hueco b{ display:block; color:#B9C2E8; font-size:0.86rem; }

.k3-pv-cuerpo{ padding:20px 20px 22px; }
.k3-pv-h{
  margin:0;
  font-size:1.2rem;
  font-weight:900;
  line-height:1.25;
  color:{{ COLOR_TITULO }};
}
.k3-pv-entrada{ margin:8px 0 0; font-size:0.88rem; }
.k3-pv-lista{
  list-style:none;
  margin:16px 0 0;
  padding:0;
  display:flex;
  flex-direction:column;
  gap:11px;
}
.k3-pv-lista li{
  display:flex;
  align-items:flex-start;
  gap:10px;
  font-size:0.94rem;
  font-weight:600;
  line-height:1.5;
}
.k3-pv-i{
  width:20px; height:20px;
  border-radius:50%;
  background:{{ COLOR_CIRCULO }};
  display:flex; align-items:center; justify-content:center;
  flex:none; margin-top:2px;
}
.k3-pv-i svg{
  width:11px; height:11px; display:block;
  fill:none; stroke:#FFFFFF; stroke-width:3;
  stroke-linecap:round; stroke-linejoin:round;
}
.k3-pv-lista b{ font-weight:800; color:{{ COLOR_TITULO }}; }
.k3-pv-remate{
  margin:16px 0 0;
  background:{{ COLOR_REMATE_BG }};
  border-radius:8px;
  padding:12px 14px;
  font-size:0.9rem;
  font-weight:700;
  color:{{ COLOR_TITULO }};
}
.k3-pv-ok{
  width:100%;
  margin-top:16px;
  border:0;
  border-radius:10px;
  background:{{ COLOR_BOTON }};
  color:#FFFFFF;
  font-family:inherit;
  font-size:1rem;
  font-weight:800;
  padding:13px 18px;
  cursor:pointer;
}
.k3-pv-ok:hover{ background:#00A9FF; }
.k3-pv-ok:focus-visible{ outline:2px solid {{ COLOR_TITULO }}; outline-offset:2px; }

@media (max-width:768px){
  .k3-pv-cuerpo{ padding:17px 17px 19px; }
  .k3-pv-h{ font-size:1.08rem; }
}
</style>

<button class="k3-pv-abrir" type="button" data-k3pv="abrir" aria-haspopup="dialog">{{ ENLACE_TEXTO }}</button>

<div class="k3-pv-fondo" data-k3pv="fondo" role="dialog" aria-modal="true" aria-labelledby="k3pvTitulo">
  <div class="k3-pv-caja">
    <button class="k3-pv-cerrar" type="button" data-k3pv="cerrar" aria-label="Cerrar">&times;</button>

    {%- assign _l = MEDIA | downcase -%}
    {%- if MEDIA == blank -%}
      <div class="k3-pv-hueco" style="aspect-ratio:{{ MEDIA_RATIO }}"><b>VÍDEO · 3-4 segundos</b>la habitación con la luz encendida y, de golpe, con el proyector<br>grabado con el móvil, sin retocar</div>
    {%- elsif _l contains 'youtube.com' or _l contains 'youtu.be' -%}
      {%- assign _id = MEDIA | split: 'v=' | last | split: '/' | last | split: '?' | first -%}
      <div class="k3-pv-marco" style="aspect-ratio:{{ MEDIA_RATIO }}"><iframe data-k3pv="iframe" data-src="https://www.youtube-nocookie.com/embed/{{ _id }}?rel=0&autoplay=1&mute=1&loop=1&playlist={{ _id }}" src="" title="{{ ENLACE_TEXTO | escape }}" allow="autoplay; encrypted-media" allowfullscreen></iframe></div>
    {%- elsif _l contains 'vimeo.com' -%}
      {%- assign _id = MEDIA | split: '/' | last | split: '?' | first -%}
      <div class="k3-pv-marco" style="aspect-ratio:{{ MEDIA_RATIO }}"><iframe data-k3pv="iframe" data-src="https://player.vimeo.com/video/{{ _id }}?autoplay=1&muted=1&loop=1" src="" title="{{ ENLACE_TEXTO | escape }}" allow="autoplay" allowfullscreen></iframe></div>
    {%- elsif _l contains '.mp4' or _l contains '.webm' or _l contains '.mov' -%}
      <video class="k3-pv-media" data-k3pv="video" style="aspect-ratio:{{ MEDIA_RATIO }}" src="{{ MEDIA }}" muted loop playsinline preload="none"></video>
    {%- else -%}
      <img class="k3-pv-media" style="aspect-ratio:{{ MEDIA_RATIO }}" src="{{ MEDIA }}" alt="{{ ENLACE_TEXTO | escape }}" loading="lazy" decoding="async">
    {%- endif -%}

    <div class="k3-pv-cuerpo">
      <h2 class="k3-pv-h" id="k3pvTitulo">{{ POPUP_TITULO }}</h2>
      {%- if POPUP_ENTRADA != blank -%}<p class="k3-pv-entrada">{{ POPUP_ENTRADA }}</p>{%- endif -%}

      <ul class="k3-pv-lista">
        {%- assign _lista = CONDICIONES | split: '~' -%}
        {%- for c in _lista -%}
          {%- assign _c = c | split: '|' -%}
          <li>
            <span class="k3-pv-i" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M4 12.5l5.5 5.5L20 7"/></svg></span>
            <span><b>{{ _c[0] }}</b>{% if _c[1] != blank %} {{ _c[1] }}{% endif %}</span>
          </li>
        {%- endfor -%}
      </ul>

      {%- if POPUP_REMATE != blank -%}<p class="k3-pv-remate">{{ POPUP_REMATE }}</p>{%- endif -%}
      <button class="k3-pv-ok" type="button" data-k3pv="cerrar">{{ BOTON_CERRAR }}</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';
  var abrir  = document.querySelector('[data-k3pv="abrir"]');
  var fondo  = document.querySelector('[data-k3pv="fondo"]');
  if (!abrir || !fondo) { return; }

  var video   = fondo.querySelector('[data-k3pv="video"]');
  var iframe  = fondo.querySelector('[data-k3pv="iframe"]');
  var cerrars = fondo.querySelectorAll('[data-k3pv="cerrar"]');
  var previo  = null;
  var i;

  function abrirPopup() {
    previo = document.activeElement;
    fondo.className = 'k3-pv-fondo abierto';
    document.body.style.overflow = 'hidden';

    if (video) {
      video.currentTime = 0;
      var p = video.play();
      if (p && typeof p.catch === 'function') { p.catch(function () {}); }
    }
    if (iframe && !iframe.getAttribute('src')) {
      iframe.setAttribute('src', iframe.getAttribute('data-src'));
    }
    if (cerrars.length) { cerrars[0].focus(); }
  }

  function cerrarPopup() {
    fondo.className = 'k3-pv-fondo';
    document.body.style.overflow = '';

    if (video) { video.pause(); }
    if (iframe) { iframe.setAttribute('src', ''); }
    if (previo && typeof previo.focus === 'function') { previo.focus(); }
  }

  abrir.addEventListener('click', abrirPopup);

  for (i = 0; i < cerrars.length; i++) {
    cerrars[i].addEventListener('click', cerrarPopup);
  }

  fondo.addEventListener('click', function (e) {
    if (e.target === fondo) { cerrarPopup(); }
  });

  document.addEventListener('keydown', function (e) {
    var esc = (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27);
    if (esc && fondo.className.indexOf('abierto') !== -1) { cerrarPopup(); }
  });
}());
</script>

{%- endif -%}
