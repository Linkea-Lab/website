{% doc %}
  @prompt
    generame un bloque para 3 videos de reproduccion automatica sin audio
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-trio-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-video-trio-{{ ai_gen_id }}__heading {
    margin: 0 0 20px;
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    text-align: {{ block.settings.alignment }};
  }

  .ai-video-trio-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-video-trio-{{ ai_gen_id }}__item {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    background: {{ block.settings.placeholder_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-trio-{{ ai_gen_id }}__video,
  .ai-video-trio-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-trio-{{ ai_gen_id }}__video--top { object-position: center top; }
  .ai-video-trio-{{ ai_gen_id }}__video--center { object-position: center center; }
  .ai-video-trio-{{ ai_gen_id }}__video--bottom { object-position: center bottom; }

  .ai-video-trio-{{ ai_gen_id }}__placeholder {
    position: relative;
    color: {{ block.settings.placeholder_text_color }};
  }

  .ai-video-trio-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-video-trio-{{ ai_gen_id }}__empty-text {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    font-size: 13px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-video-trio-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }

    .ai-video-trio-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<video-trio-{{ ai_gen_id }} class="ai-video-trio-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-video-trio-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-video-trio-{{ ai_gen_id }}__grid">
    {% for i in (1..3) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign video_url = block.settings[video_key]
        assign crop_key = 'crop_' | append: i
        assign crop = block.settings[crop_key] | default: 'center'
      %}
      <div class="ai-video-trio-{{ ai_gen_id }}__item">
        {% if video_url != blank %}
          <video
            class="ai-video-trio-{{ ai_gen_id }}__video ai-video-trio-{{ ai_gen_id }}__video--{{ crop }}"
            src="{{ video_url }}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Vídeo {{ i }}"
          ></video>
        {% else %}
          <div class="ai-video-trio-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span class="ai-video-trio-{{ ai_gen_id }}__empty-text">Añade la URL del vídeo {{ i }}</span>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</video-trio-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoTrio{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('video').forEach((video) => {
          video.muted = true;
          video.play().catch(function() {});
        });
      }
    }

    if (!customElements.get('video-trio-{{ ai_gen_id }}')) {
      customElements.define('video-trio-{{ ai_gen_id }}', VideoTrio{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Tres vídeos autoplay",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Descubre nuestros vídeos"
    },
    {
      "type": "url",
      "id": "video_1",
      "label": "URL del vídeo 1"
    },
    {
      "type": "select",
      "id": "crop_1",
      "label": "Vídeo 1 · qué parte se conserva",
      "options": [
        { "value": "top", "label": "Arriba (corta por abajo)" },
        { "value": "center", "label": "Centro (corta por los dos lados)" },
        { "value": "bottom", "label": "Abajo (corta por arriba)" }
      ],
      "default": "top"
    },
    {
      "type": "url",
      "id": "video_2",
      "label": "URL del vídeo 2"
    },
    {
      "type": "select",
      "id": "crop_2",
      "label": "Vídeo 2 · qué parte se conserva",
      "options": [
        { "value": "top", "label": "Arriba (corta por abajo)" },
        { "value": "center", "label": "Centro (corta por los dos lados)" },
        { "value": "bottom", "label": "Abajo (corta por arriba)" }
      ],
      "default": "top"
    },
    {
      "type": "url",
      "id": "video_3",
      "label": "URL del vídeo 3"
    },
    {
      "type": "select",
      "id": "crop_3",
      "label": "Vídeo 3 · qué parte se conserva",
      "options": [
        { "value": "top", "label": "Arriba (corta por abajo)" },
        { "value": "center", "label": "Centro (corta por los dos lados)" },
        { "value": "bottom", "label": "Abajo (corta por arriba)" }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho de escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Proporción",
      "info": "Con vídeos 9:16: panorámica recorta el 68 %, cuadrada el 44 %, 4:5 el 30 %, 3:4 el 25 % y 9:16 no recorta nada.",
      "options": [
        { "value": "16 / 9", "label": "Panorámica (16:9)" },
        { "value": "1 / 1", "label": "Cuadrada (1:1)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "3 / 4", "label": "Vertical alta (3:4)" },
        { "value": "9 / 16", "label": "Vertical completa (9:16) · sin recorte" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio de esquina",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Título en móvil",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Fondo vacío",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Texto vacío",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Tres vídeos autoplay"
    }
  ],
  "tag": null,
  "class": "video-trio-block"
}
{% endschema %}
