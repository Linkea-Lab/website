{%- comment -%} ═══════════════════ EDITA AQUÍ ═══════════════════ {%- endcomment -%}
{%- assign MEDIA = '' -%}
{%- comment -%} Aquí un vídeo rinde mucho más que una foto. 1000x750 px {%- endcomment -%}

{%- assign EYEBROW = 'La aurora' -%}
{%- assign TITULO  = 'No son cuatro puntitos: es el techo entero moviéndose' -%}
{%- assign PARRAFO_1 = 'Los proyectores baratos tiran unas estrellas fijas y poco más. Este pinta ondas de aurora boreal que se desplazan despacio por el techo y las paredes, cambian de color y se regulan en intensidad.' -%}
{%- assign PARRAFO_2 = 'Puedes dejarlo quieto y tenue como luz de fondo, o ponerlo a girar y convertir el salón en otra cosa.' -%}
{%- assign REMATE  = 'Es lo que hace que la gente saque el móvil para grabarlo.' -%}


{%- assign COLOR_FONDO   = '#0F1430' -%}
{%- assign COLOR_TITULO  = '#FFFFFF' -%}
{%- assign COLOR_TEXTO   = '#B9C2E8' -%}
{%- assign COLOR_ACENTO  = '#38B6FF' -%}
{%- assign COLOR_REMATE  = '#FFFFFF' -%}
{%- assign COLOR_HUECO   = '#1A2148' -%}
{%- assign COLOR_HUECO_BORDE = '#39427A' -%}
{%- assign COLOR_HUECO_TXT   = '#7C86BC' -%}
{%- assign CARGAR_FUENTE = false -%}
{%- comment -%} En false porque la fuente ya se carga desde theme.liquid, autoalojada.
                Ponlo en true solo si pegas este bloque en una tienda que no la tenga. {%- endcomment -%}

{%- comment -%} ══════════ FIN · NO TOQUES NADA MÁS ABAJO ═════════ {%- endcomment -%}

{%- if CARGAR_FUENTE -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap">
{%- endif -%}


<style>
.k-est{
  font-family:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
  line-height:1.6;
  -webkit-text-size-adjust:100%;
  background:{{ COLOR_FONDO }};
  color:{{ COLOR_TEXTO }};
  padding-block:64px;
}
.k-est-env{ max-width:1140px; margin-left:auto; margin-right:auto; padding-left:16px; padding-right:16px; }
.k-est-duo{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:clamp(22px,3.4vw,48px);
  align-items:center;
}
.k-est-media-col{ order:2; }
.k-est-txt{ display:flex; flex-direction:column; gap:14px; }
.k-est-eyebrow{
  margin:0;
  font-size:0.7rem; font-weight:800;
  letter-spacing:0.14em; text-transform:uppercase;
  color:{{ COLOR_ACENTO }};
}
.k-est-h2{
  margin:0;
  font-size:clamp(1.45rem,3.2vw,2rem);
  font-weight:800; letter-spacing:-0.015em; line-height:1.2;
  color:{{ COLOR_TITULO }};
}
.k-est-txt p{ margin:0; }
.k-est-remate{ color:{{ COLOR_REMATE }}; font-weight:800; }
.k-est-media{ width:100%; max-width:100%; height:auto; display:block; border-radius:10px; object-fit:cover; }
.k-est-marco{ position:relative; width:100%; border-radius:10px; overflow:hidden; background:#000000; }
.k-est-marco iframe{ position:absolute; top:0; left:0; width:100%; height:100%; border:0; }
.k-est-hueco{
  width:100%;
  border:1px dashed {{ COLOR_HUECO_BORDE }};
  border-radius:10px;
  background:{{ COLOR_HUECO }};
  color:{{ COLOR_HUECO_TXT }};
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:6px; text-align:center; padding:18px;
  font-size:0.78rem; font-weight:700;
}
.k-est-hueco b{ display:block; font-size:0.84rem; }

@media (max-width:768px){
  .k-est{ padding-block:44px; }
  .k-est-duo{ grid-template-columns:1fr; }
  .k-est-media-col{ order:0; }
}
</style>

<section class="k-est">
  <div class="k-est-env">
    <div class="k-est-duo">
      <div class="k-est-media-col">
        {%- assign _m = MEDIA -%}
        {%- assign _l = _m | downcase -%}
        {%- if _m == blank -%}
          <div class="k-est-hueco" style="aspect-ratio:4/3"><b>VÍDEO</b>el techo entero con la aurora moviéndose<br>1000 × 750 px</div>
        {%- elsif _l contains 'youtube.com' or _l contains 'youtu.be' -%}
          {%- assign _id = _m | split: 'v=' | last | split: '/' | last | split: '?' | first -%}
          <div class="k-est-marco" style="aspect-ratio:4/3"><iframe src="https://www.youtube-nocookie.com/embed/{{ _id }}?rel=0" title="{{ TITULO | escape }}" loading="lazy" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture"></iframe></div>
        {%- elsif _l contains 'vimeo.com' -%}
          {%- assign _id = _m | split: '/' | last | split: '?' | first -%}
          <div class="k-est-marco" style="aspect-ratio:4/3"><iframe src="https://player.vimeo.com/video/{{ _id }}" title="{{ TITULO | escape }}" loading="lazy" allowfullscreen></iframe></div>
        {%- elsif _l contains '.mp4' or _l contains '.webm' or _l contains '.mov' -%}
          <video class="k-est-media" style="aspect-ratio:4/3" src="{{ _m }}" autoplay muted loop playsinline preload="metadata"></video>
        {%- else -%}
          <img class="k-est-media" style="aspect-ratio:4/3" src="{{ _m }}" alt="{{ TITULO | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
      <div class="k-est-txt">
        <p class="k-est-eyebrow">{{ EYEBROW }}</p>
        <h2 class="k-est-h2">{{ TITULO }}</h2>
        <p>{{ PARRAFO_1 }}</p>
        <p>{{ PARRAFO_2 }}</p>
        <p class="k-est-remate">{{ REMATE }}</p>
      </div>
    </div>
  </div>
</section>
