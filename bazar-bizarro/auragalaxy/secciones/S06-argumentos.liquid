{%- comment -%}
█████████████████████████████████████████████████████████████████
██  SECCIÓN · LOS SEIS ARGUMENTOS
██  Todo lo editable está entre las dos rayas de abajo.
█████████████████████████████████████████████████████████████████
{%- endcomment -%}

{%- comment -%} ═══════════════════ EDITA AQUÍ ═══════════════════ {%- endcomment -%}
{%- assign EYEBROW = 'Por qué este y no el de 12 €' -%}
{%- assign TITULO  = 'Seis razones para que no acabe en un cajón' -%}

{%- comment -%} Fotos cuadradas, 400x400 px. Salen recortadas en círculo. {%- endcomment -%}
{%- assign FOTO_1 = '' -%}
{%- assign FOTO_2 = '' -%}
{%- assign FOTO_3 = '' -%}
{%- assign FOTO_4 = '' -%}
{%- assign FOTO_5 = '' -%}
{%- assign FOTO_6 = '' -%}

{%- comment -%} Cada uno: titular | texto | pista del hueco · separa con ~ · el orden manda {%- endcomment -%}
{%- assign ARGUMENTOS = 'Se maneja sin levantarse|Mando a distancia y botones en el aparato. Cambias el ambiente sin entrar en la habitación.|mando~Se apaga solo|Temporizador de 1 h, 2 h o 4 h. No te lo dejas encendido toda la noche.|temporizador~Va sin enchufe|Batería recargable por USB-C. Lo llevas de una habitación a otra, o a casa de alguien.|batería~Un aparato, muchos ambientes|Millones de combinaciones de color, brillo y velocidad. Sirve para dormir, para trabajar y para una fiesta.|colores~Ya viene con sonido|Ruido blanco dentro (lluvia, olas, grillos) y altavoz Bluetooth para poner lo tuyo. Sin traer otro cacharro más.|sonido~Apagado no desentona|Es un huevo de dragón con textura y grietas. Se queda en la estantería, no escondido.|huevo' -%}

{%- assign COLOR_FONDO   = '#FFFFFF' -%}
{%- assign COLOR_TITULO  = '#222222' -%}
{%- assign COLOR_TEXTO   = '#444444' -%}
{%- assign COLOR_ACENTO  = '#0B6FA8' -%}
{%- assign COLOR_HUECO   = '#F5F5F5' -%}
{%- assign COLOR_HUECO_BORDE = '#E5E5E5' -%}
{%- assign COLOR_HUECO_TXT   = '#9AA0B4' -%}
{%- assign CARGAR_FUENTE = false -%}
{%- comment -%} En false porque la fuente ya se carga desde theme.liquid, autoalojada.
                Ponlo en true solo si pegas este bloque en una tienda que no la tenga. {%- endcomment -%}

{%- comment -%} ══════════ FIN · NO TOQUES NADA MÁS ABAJO ═════════ {%- endcomment -%}

{%- if CARGAR_FUENTE -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap">
{%- endif -%}


<style>
.k-arg{
  font-family:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
  line-height:1.6;
  -webkit-text-size-adjust:100%;
  background:{{ COLOR_FONDO }};
  color:{{ COLOR_TEXTO }};
  padding-block:64px;
}
.k-arg-env{ max-width:1140px; margin-left:auto; margin-right:auto; padding-left:16px; padding-right:16px; }
.k-arg-eyebrow{ margin:0 0 10px; font-size:0.7rem; font-weight:800; letter-spacing:0.14em; text-transform:uppercase; color:{{ COLOR_ACENTO }}; }
.k-arg-h2{ margin:0; font-size:clamp(1.45rem,3.2vw,2rem); font-weight:800; letter-spacing:-0.015em; line-height:1.2; color:{{ COLOR_TITULO }}; }
.k-arg-rej{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,2.4vw,28px); margin-top:30px; }
.k-arg-t{ display:flex; flex-direction:column; gap:9px; }
.k-arg-t p{ margin:0; font-size:0.9rem; }
.k-arg-h3{ margin:0; font-size:1.08rem; font-weight:800; color:{{ COLOR_TITULO }}; }
.k-arg-media{ width:100%; max-width:100%; height:auto; display:block; border-radius:10px; object-fit:cover; }
.k-arg-marco{ position:relative; width:100%; border-radius:10px; overflow:hidden; background:#000000; }
.k-arg-marco iframe{ position:absolute; top:0; left:0; width:100%; height:100%; border:0; }
.k-arg-hueco{
  width:100%;
  border:1px dashed {{ COLOR_HUECO_BORDE }};
  border-radius:10px;
  background:{{ COLOR_HUECO }};
  color:{{ COLOR_HUECO_TXT }};
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:6px; text-align:center; padding:18px;
  font-size:0.78rem; font-weight:700;
}
.k-arg-hueco b{ display:block; font-size:0.84rem; }

.k-arg-media, .k-arg-hueco{ border-radius:50%; max-width:126px; }
@media (max-width:1024px){ .k-arg-rej{ grid-template-columns:repeat(2,1fr); } }
@media (max-width:768px){
  .k-arg{ padding-block:44px; }
  .k-arg-rej{ grid-template-columns:1fr; }
}
</style>

<section class="k-arg">
  <div class="k-arg-env">
    <p class="k-arg-eyebrow">{{ EYEBROW }}</p>
    <h2 class="k-arg-h2">{{ TITULO }}</h2>
    <div class="k-arg-rej">
      {%- assign _f = FOTO_1 | append: '||' | append: FOTO_2 | append: '||' | append: FOTO_3 | append: '||' | append: FOTO_4 | append: '||' | append: FOTO_5 | append: '||' | append: FOTO_6 | split: '||' -%}
      {%- assign _lista = ARGUMENTOS | split: '~' -%}
      {%- for a in _lista -%}
        {%- assign i = forloop.index0 -%}
        {%- assign _c = a | split: '|' -%}
        <article class="k-arg-t">
          {%- assign MEDIA = _f[i] | default: '' -%}
          {%- assign _m = MEDIA -%}
        {%- assign _l = _m | downcase -%}
        {%- if _m == blank -%}
          <div class="k-arg-hueco" style="aspect-ratio:1/1"><b>FOTO</b>{{ _c[2] }}</div>
        {%- elsif _l contains 'youtube.com' or _l contains 'youtu.be' -%}
          {%- assign _id = _m | split: 'v=' | last | split: '/' | last | split: '?' | first -%}
          <div class="k-arg-marco" style="aspect-ratio:1/1"><iframe src="https://www.youtube-nocookie.com/embed/{{ _id }}?rel=0" title="{{ _c[0] | escape }}" loading="lazy" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture"></iframe></div>
        {%- elsif _l contains 'vimeo.com' -%}
          {%- assign _id = _m | split: '/' | last | split: '?' | first -%}
          <div class="k-arg-marco" style="aspect-ratio:1/1"><iframe src="https://player.vimeo.com/video/{{ _id }}" title="{{ _c[0] | escape }}" loading="lazy" allowfullscreen></iframe></div>
        {%- elsif _l contains '.mp4' or _l contains '.webm' or _l contains '.mov' -%}
          <video class="k-arg-media" style="aspect-ratio:1/1" src="{{ _m }}" autoplay muted loop playsinline preload="metadata"></video>
        {%- else -%}
          <img class="k-arg-media" style="aspect-ratio:1/1" src="{{ _m }}" alt="{{ _c[0] | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
          <h3 class="k-arg-h3">{{ _c[0] }}</h3>
          <p>{{ _c[1] }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
